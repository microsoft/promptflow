- name: Random Wait
  uses: AliSajid/random-wait-action@933d3635c56777d240b67abe794f1a5f7bdfd063 # v2.12.0
  with:
    minimum: 0
    maximum: 99
- name: {{ step_name }}
  uses: azure/login@v1
  with:
    subscription-id: ${{ '{{' }}secrets.AZURE_SUBSCRIPTION_ID}}
    tenant-id: ${{ '{{' }}secrets.AZURE_TENANT_ID}}
    client-id: ${{ '{{' }}secrets.AZURE_CLIENT_ID}}